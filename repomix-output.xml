	[RelayCommand]
	private void ShowPreviewMode(string mode)
	{
		var corpse = mode.Equals("Corpse", StringComparison.OrdinalIgnoreCase);
		if (_previewCorpse == corpse) return;
		_previewCorpse = corpse;
