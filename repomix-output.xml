				ThingKind.Outfit => _catalog.EnumerateOutfits().ToList(),
				ThingKind.Effect => _catalog.EnumerateEffects().ToList(),
				ThingKind.Missile => _catalog.EnumerateMissiles().ToList(),
				_ => Array.Empty<ThingType>(),
